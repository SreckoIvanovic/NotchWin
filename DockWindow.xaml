<Window x:Class="NotchWin.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchWin Dock" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="IconInk" Color="#F2FFFFFF"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LineIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource IconInk}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
        </Style>

        <Style x:Key="CcBtn" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Border x:Name="Capsule" Height="62" CornerRadius="31" Padding="8" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E6363C4C" Offset="0"/>
                    <GradientStop Color="#EB1A1E2A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#59FFFFFF" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Hide dock" Click="HideDock_Click"/>
                    <MenuItem Header="Taskbar settings (auto-hide)…" Click="TaskbarSettings_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <StackPanel Orientation="Horizontal">

                <Border x:Name="MediaPill" Height="46" CornerRadius="23" Background="#F5000000" Padding="6,0,18,0"
                        MinWidth="170" MaxWidth="240" Cursor="Hand" MouseLeftButtonUp="MediaPill_Click"
                        BorderBrush="#1AFFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Ellipse Fill="#1ED760"/>
                            <Path x:Name="MediaGlyph" Fill="Black" Width="16" Height="16" Stretch="Uniform"
                                  Data="M9,18 V5 L21,3 V16 M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 Z M21,16 A3,3 0 1 1 15,16 A3,3 0 1 1 21,16 Z"
                                  Stroke="Black" StrokeThickness="1.5"/>
                            <Ellipse x:Name="MediaArt" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="MediaArtBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Grid x:Name="MediaHover" Opacity="0">
                                <Ellipse Fill="#99000000"/>
                                <Path x:Name="MediaHoverIcon" Fill="White" Width="12" Height="12" Stretch="Uniform"
                                      Data="M7,4.5 L19.5,12 L7,19.5 Z"/>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaApp" Text="Music" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MediaSub" Text="Nothing playing" Foreground="#A6FFFFFF" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Height="46" CornerRadius="23" Background="#33000000" Padding="4,0" Margin="8,0">
                    <Grid x:Name="AppsHost" VerticalAlignment="Center">
                        <Border x:Name="ActiveIndicator" Width="40" Height="40" CornerRadius="13" HorizontalAlignment="Left"
                                Opacity="0" BorderThickness="1.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ActiveX"/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4DFFFFFF" Offset="0"/>
                                    <GradientStop Color="#1FFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#C0A8D4FF" Offset="0"/>
                                    <GradientStop Color="#664C9BFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="#0A84FF"/>
                            </Border.Effect>
                        </Border>

                        <ItemsControl x:Name="AppsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="44" Height="40" Background="Transparent" Cursor="Hand" Tag="{Binding}"
                                          MouseLeftButtonUp="App_Click" MouseEnter="App_Enter" MouseLeave="App_Leave"
                                          ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="600">
                                        <Image Source="{Binding Icon}" Width="27" Height="27" RenderTransformOrigin="0.5,0.6"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.RenderTransform>
                                                <ScaleTransform/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <Ellipse Width="4" Height="4" Fill="#C8FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,0.5"
                                                 Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Height="46" CornerRadius="23" Background="#1FFFFFFF" Padding="4" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ClockPill" Height="36" CornerRadius="18" Background="#40000000" Padding="16,0"
                                Cursor="Hand" MouseLeftButtonUp="Clock_Click" ToolTip="Calendar">
                            <TextBlock x:Name="ClockText" Text="00:00" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center"/>
                        </Border>

                        <Border Style="{StaticResource CcBtn}" Margin="4,0,0,0" MouseLeftButtonUp="Wifi_Click" x:Name="WifiBtn">
                            <Grid>
                                <Path x:Name="WifiIcon" Style="{StaticResource LineIcon}"
                                      Data="M2,8.5 A15,15 0 0 1 22,8.5 M5,12 A10.5,10.5 0 0 1 19,12 M8.5,15.5 A5.5,5.5 0 0 1 15.5,15.5 M12,19.5 L12.01,19.5"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CcBtn}" MouseLeftButtonUp="Volume_Click" MouseWheel="Volume_Wheel" x:Name="VolBtn">
                            <Path x:Name="VolIcon" Style="{StaticResource LineIcon}"
                                  Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M15.54,8.46 A5,5 0 0 1 15.54,15.54 M19.07,4.93 A10,10 0 0 1 19.07,19.07"/>
                        </Border>

                        <Border Style="{StaticResource CcBtn}" Background="#26FFFFFF" Width="44" MouseLeftButtonUp="Battery_Click" x:Name="BatBtn">
                            <Grid Width="25" Height="12">
                                <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5" BorderThickness="1.3" BorderBrush="#E6FFFFFF">
                                    <Border x:Name="BatFill" HorizontalAlignment="Left" Margin="1.5" CornerRadius="1.6" Background="White" Width="10"/>
                                </Border>
                                <Border Width="2" Height="5" HorizontalAlignment="Right" CornerRadius="0,1.2,1.2,0" Background="#E6FFFFFF"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="NotchWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchWin" Width="560" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        AllowDrop="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Dim" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
        <SolidColorBrush x:Key="Chip" Color="#26FFFFFF"/>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Chip}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Notch" Background="Black" CornerRadius="0,0,26,26"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Width="230" Height="34" ClipToBounds="True">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Izlaz" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid x:Name="CollapsedView" Margin="16,0">
                <TextBlock x:Name="PillText" Foreground="{StaticResource Fg}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                <Ellipse x:Name="PillMicDot" Width="8" Height="8" Fill="#FF453A"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <Grid x:Name="ExpandedView" Margin="20,12,20,14" Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button x:Name="TabBtn0" Style="{StaticResource IconBtn}" Content="🎵" Tag="0" Click="Tab_Click" ToolTip="Muzika"/>
                    <Button x:Name="TabBtn1" Style="{StaticResource IconBtn}" Content="📁" Tag="1" Click="Tab_Click" ToolTip="Fajlovi"/>
                    <Button x:Name="TabBtn2" Style="{StaticResource IconBtn}" Content="📊" Tag="2" Click="Tab_Click" ToolTip="Sistem"/>
                    <Button x:Name="TabBtn3" Style="{StaticResource IconBtn}" Content="🗓" Tag="3" Click="Tab_Click" ToolTip="Kalendar"/>
                    <Button x:Name="TabBtn4" Style="{StaticResource IconBtn}" Content="🎤" Tag="4" Click="Tab_Click" ToolTip="Mikrofon"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid x:Name="Panel0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="88" Height="88" CornerRadius="14" Background="#1C1C1E" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="♪" FontSize="34" Foreground="{StaticResource Dim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TitleText" Text="Ništa se ne pušta" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" Grid.Row="1" FontSize="13"
                                       Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="MediaProgress" Grid.Row="2" Style="{StaticResource Bar}" Margin="0,10,0,2"/>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Style="{StaticResource IconBtn}" Content="⏮" Click="Prev_Click"/>
                                <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="▶" FontSize="20" Width="46" Click="PlayPause_Click"/>
                                <Button Style="{StaticResource IconBtn}" Content="⏭" Click="Next_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="Panel1" Visibility="Collapsed">
                        <TextBlock x:Name="ShelfHint" Text="Prevuci fajlove ovdje da ih privremeno čuvaš"
                                   Foreground="{StaticResource Dim}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ListBox x:Name="ShelfList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonDown="Shelf_PreviewMouseDown"
                                 PreviewMouseMove="Shelf_PreviewMouseMove"
                                 MouseDoubleClick="Shelf_DoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="#1AFFFFFF" CornerRadius="8" Margin="0,0,0,4" Padding="10,5">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="ShelfRemove_Click"
                                                Style="{StaticResource IconBtn}" Width="24" Height="22" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel x:Name="Panel2" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="CpuBar" Grid.Column="1" Style="{StaticResource Bar}"/>
                            <TextBlock x:Name="CpuText" Grid.Column="2" Foreground="{StaticResource Fg}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="RamBar" Grid.Column="1" Style="{StaticResource Bar}"/>
                            <TextBlock x:Name="RamText" Grid.Column="2" Foreground="{StaticResource Fg}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BatLabel" Text="Baterija" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="BatBar" Grid.Column="1" Style="{StaticResource Bar}" Foreground="#30D158"/>
                            <TextBlock x:Name="BatText" Grid.Column="2" Foreground="{StaticResource Fg}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zvuk" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <Slider x:Name="VolSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" ValueChanged="Vol_Changed" Focusable="False"/>
                            <TextBlock x:Name="VolText" Grid.Column="2" Foreground="{StaticResource Fg}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="Panel3" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="BigClock" FontSize="40" FontWeight="Light" Foreground="{StaticResource Fg}"/>
                            <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource Dim}" Margin="2,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="MonthText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Fg}" Margin="0,0,0,4"/>
                            <UniformGrid x:Name="CalGrid" Columns="7"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="Panel4" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="MicBtn" Width="76" Height="76" FontSize="32" Content="🎤"
                                Click="Mic_Click" Cursor="Hand" Focusable="False" HorizontalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="38">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="MicText" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{StaticResource Fg}" FontSize="13"/>
                        <TextBlock Text="Prečica: Ctrl + Alt + M (radi u svakoj aplikaciji)" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

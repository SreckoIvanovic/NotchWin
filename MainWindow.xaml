<Window x:Class="NotchWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchWin" Width="660" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Fg" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="Dim" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
        <SolidColorBrush x:Key="Hover" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="Track" Color="#1FFFFFFF"/>

        <LinearGradientBrush x:Key="ActiveTab" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4C9BFF" Offset="0"/>
            <GradientStop Color="#1868F2" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CpuGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A84FF" Offset="0"/>
            <GradientStop Color="#5AC8FA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RamGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E6BFF" Offset="0"/>
            <GradientStop Color="#7D6BFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BatGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#28B84F" Offset="0"/>
            <GradientStop Color="#6EE78A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MusicGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A84FF" Offset="0"/>
            <GradientStop Color="#64B5FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VolGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#C8FFFFFF" Offset="0"/>
            <GradientStop Color="#FFFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="TabGlow" Color="#0A84FF" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>

        <Style x:Key="LineIcon" TargetType="Path">
            <Setter Property="Stroke" Value="#AEAEB2"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="15"/>
                            <Border x:Name="hov" Background="{StaticResource Hover}" CornerRadius="15" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hov" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="bg" Fill="{StaticResource Hover}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemCloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1CFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                CornerRadius="11" Padding="11,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse StrokeThickness="1">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#12FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse x:Name="hov" Fill="{StaticResource Hover}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hov" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource Track}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3.5"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0A84FF" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KnobBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Height="5" CornerRadius="2.5" Background="{StaticResource Track}"/>
                            <Border x:Name="PART_Track"/>
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="False">
                                <Border Height="5" CornerRadius="2.5" Background="{StaticResource MusicGrad}"/>
                                <Ellipse Width="11" Height="11" Fill="#7FB8FF" HorizontalAlignment="Right" Margin="0,0,-5.5,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#0A84FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FillRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="{StaticResource VolGrad}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EmptyRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Knob" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="17" Height="17" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.5" Color="Black"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="6" CornerRadius="3" Background="{StaticResource Track}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource FillRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource EmptyRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Knob}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7C7CC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GlassItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="#12FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="12" Margin="0,0,0,6" Padding="10,6,6,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource GlassItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Glow" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="260" Height="34" Opacity="0" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.5" RadiusY="0.7">
                    <GradientStop Color="#550A84FF" Offset="0"/>
                    <GradientStop Color="#500A84FF" Offset="0.7"/>
                    <GradientStop Color="#307A5CFF" Offset="0.85"/>
                    <GradientStop Color="#007A5CFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="Notch" CornerRadius="0,0,18,18" BorderThickness="1,0,1,1"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="260" Height="34" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#FF020204" Offset="0.5"/>
                    <GradientStop Color="#FF0B0D18" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#26FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="AutoStartItem" Header="Start with Windows" IsCheckable="True" Click="AutoStart_Click"/>
                    <MenuItem Header="Settings (weather city)…" Click="OpenSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid x:Name="CollapsedView" Width="260" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="18,0,16,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="PillBattery" HorizontalAlignment="Left" VerticalAlignment="Center" Width="27" Height="13">
                            <Border Width="24" HorizontalAlignment="Left" CornerRadius="3.5" BorderThickness="1.2" BorderBrush="#9AFFFFFF">
                                <Border x:Name="PillBatFill" HorizontalAlignment="Left" Margin="1.4" CornerRadius="1.8" Background="White" Width="10"/>
                            </Border>
                            <Border Width="2" Height="5" HorizontalAlignment="Right" Margin="0,0,0.5,0" CornerRadius="0,1.2,1.2,0" Background="#9AFFFFFF"/>
                            <Path x:Name="PillBolt" Data="M7.5,0.5 L4,7 H7 L6,12.5 L10,5.5 H7 Z" Fill="White" Stroke="Black" StrokeThickness="0.8"
                                  Width="7" Height="11" Stretch="Uniform" HorizontalAlignment="Left" Margin="8.5,0,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <TextBlock x:Name="PillTime" Grid.Column="1" Text="00:00" Foreground="White" FontSize="14"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel x:Name="PillWeather" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                <Canvas x:Name="WeatherCanvas" Width="24" Height="24"/>
                            </Viewbox>
                            <TextBlock x:Name="PillTemp" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="PeekView" Width="420" Height="74" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.CacheMode>
                        <BitmapCache EnableClearType="True" SnapsToDevicePixels="True"/>
                    </Grid.CacheMode>
                    <Grid Margin="18,10,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#22FFFFFF" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Fg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush x:Name="PeekIcon" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PeekHeader" Foreground="{StaticResource Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PeekTitle" Foreground="{StaticResource Fg}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PeekBody" Foreground="#C7C7CC" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="ExpandedView" Width="540" Height="214" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.CacheMode>
                        <BitmapCache EnableClearType="True" SnapsToDevicePixels="True"/>
                    </Grid.CacheMode>

                    <Rectangle VerticalAlignment="Bottom" Height="80" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,1.1" GradientOrigin="0.5,1.1" RadiusX="0.45" RadiusY="1">
                                <GradientStop Color="#2A0A84FF" Offset="0"/>
                                <GradientStop Color="#000A84FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Margin="22,7,22,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border HorizontalAlignment="Center" CornerRadius="19" Padding="4" Margin="0,0,0,10"
                                Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TabBtn0" Style="{StaticResource TabBtn}" Content="&#xE8D6;" Tag="0" Click="Tab_Click"/>
                                <Button x:Name="TabBtn1" Style="{StaticResource TabBtn}" Content="&#xE8B7;" Tag="1" Click="Tab_Click"/>
                                <Button x:Name="TabBtn2" Style="{StaticResource TabBtn}" Content="&#xE9D9;" Tag="2" Click="Tab_Click"/>
                                <Button x:Name="TabBtn3" Style="{StaticResource TabBtn}" Content="&#xE787;" Tag="3" Click="Tab_Click"/>
                                <Grid>
                                    <Button x:Name="TabBtn4" Style="{StaticResource TabBtn}" Content="&#xEA8F;" Tag="4" Click="Tab_Click"/>
                                    <Border x:Name="NotifBadge" Visibility="Collapsed" IsHitTestVisible="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,5,0"
                                            MinWidth="14" Height="14" CornerRadius="7" Background="#FF453A" Padding="3.5,0">
                                        <TextBlock x:Name="NotifBadgeText" FontSize="9" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid x:Name="Panel0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="92" Height="92" CornerRadius="16" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3A3A3C" Offset="0"/>
                                            <GradientStop Color="#1C1C1E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.6" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="#636366"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border CornerRadius="16">
                                            <Border.Background>
                                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,0,14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="17" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ArtistText" FontSize="13" Margin="0,1,0,0"
                                               Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar x:Name="MediaProgress" Style="{StaticResource KnobBar}" Margin="0,13,6,0"/>
                                    <Grid Margin="0,3,0,0">
                                        <TextBlock x:Name="PosText" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                                        <TextBlock x:Name="DurText" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource GlassBtn}" Content="&#xE768;" Margin="3,0" Click="PlayPause_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="Panel1" Visibility="Collapsed">
                                <Border x:Name="ShelfHint" CornerRadius="16" BorderThickness="1.5" BorderBrush="#30FFFFFF"
                                        Background="#08FFFFFF">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="22"
                                                   Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drop files here to keep them handy" Foreground="{StaticResource Dim}" FontSize="12.5"
                                                   Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="then drag them out anywhere — another folder, a chat, an email"
                                                   Foreground="#636366" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="ShelfList" Style="{StaticResource CleanList}"
                                         PreviewMouseLeftButtonDown="Shelf_PreviewMouseDown"
                                         PreviewMouseMove="Shelf_PreviewMouseMove"
                                         MouseDoubleClick="Shelf_DoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="#64B5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F5F5F7" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="&#xE711;" Tag="{Binding}" Click="ShelfRemove_Click"
                                                        Style="{StaticResource ItemCloseBtn}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Grid x:Name="Panel2" Visibility="Collapsed" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Path Style="{StaticResource LineIcon}"
                                      Data="M7,7 H17 V17 H7 Z M10,10 H14 V14 H10 Z M9.5,4 V7 M14.5,4 V7 M9.5,17 V20 M14.5,17 V20 M4,9.5 H7 M4,14.5 H7 M17,9.5 H20 M17,14.5 H20"/>
                                <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource RowLabel}"/>
                                <ProgressBar x:Name="CpuBar" Grid.Column="2" Style="{StaticResource Bar}" Foreground="{StaticResource CpuGrad}"/>
                                <TextBlock x:Name="CpuText" Grid.Column="3" Style="{StaticResource RowValue}"/>

                                <Path Grid.Row="1" Style="{StaticResource LineIcon}"
                                      Data="M3,7 H21 V15 H3 Z M6.5,10 V12 M10,10 V12 M14,10 V12 M17.5,10 V12 M6,15 V18 M10,15 V18 M14,15 V18 M18,15 V18"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Memory" Style="{StaticResource RowLabel}"/>
                                <ProgressBar x:Name="RamBar" Grid.Row="1" Grid.Column="2" Style="{StaticResource Bar}" Foreground="{StaticResource RamGrad}"/>
                                <TextBlock x:Name="RamText" Grid.Row="1" Grid.Column="3" Style="{StaticResource RowValue}"/>

                                <Path Grid.Row="2" Style="{StaticResource LineIcon}"
                                      Data="M3,8 H18 A1,1 0 0 1 19,9 V15 A1,1 0 0 1 18,16 H3 A1,1 0 0 1 2,15 V9 A1,1 0 0 1 3,8 Z M21,10.5 V13.5 M8.5,10 L6.5,12.5 H9.5 L7.5,15"/>
                                <TextBlock x:Name="BatLabel" Grid.Row="2" Grid.Column="1" Text="Battery" Style="{StaticResource RowLabel}"/>
                                <ProgressBar x:Name="BatBar" Grid.Row="2" Grid.Column="2" Style="{StaticResource Bar}" Foreground="{StaticResource BatGrad}"/>
                                <TextBlock x:Name="BatText" Grid.Row="2" Grid.Column="3" Style="{StaticResource RowValue}"/>

                                <Path Grid.Row="3" Style="{StaticResource LineIcon}"
                                      Data="M4,9.5 H7.5 L12,6 V18 L7.5,14.5 H4 Z M15.5,9.5 A3.5,3.5 0 0 1 15.5,14.5 M18,7 A7,7 0 0 1 18,17"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Volume" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="VolSlider" Grid.Row="3" Grid.Column="2" Style="{StaticResource VolSlider}"
                                        Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Vol_Changed"/>
                                <TextBlock x:Name="VolText" Grid.Row="3" Grid.Column="3" Style="{StaticResource RowValue}"/>
                            </Grid>

                            <Grid x:Name="Panel3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="BigClock" FontSize="42" FontWeight="Light" Foreground="{StaticResource Fg}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource Dim}" Margin="3,0,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="14" Background="#0DFFFFFF" BorderBrush="#14FFFFFF"
                                        BorderThickness="1" Padding="10,5">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="MonthText" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="#FF6961" Margin="4,0,0,1"/>
                                        <UniformGrid x:Name="CalGrid" Columns="7"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="Panel4" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="NotifHeader" Margin="2,0,0,6">
                                    <TextBlock x:Name="NotifCount" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource PillBtn}" Content="Clear all" HorizontalAlignment="Right" Click="ClearAll_Click"/>
                                </Grid>
                                <TextBlock x:Name="NotifEmpty" Grid.RowSpan="2" Text="No notifications" Foreground="{StaticResource Dim}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ListBox x:Name="NotifList" Grid.Row="1" Style="{StaticResource CleanList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="8" Background="#22FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Grid>
                                                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="#F5F5F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border CornerRadius="8">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Header}" Foreground="#8E8E93" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="#F5F5F7" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Body}" Foreground="#C7C7CC" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="&#xE711;" Tag="{Binding}" Click="NotifRemove_Click"
                                                        Style="{StaticResource ItemCloseBtn}" Margin="6,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

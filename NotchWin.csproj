<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NotchWin</AssemblyName>
    <RootNamespace>NotchWin</RootNamespace>

    <ApplicationIcon>Assets\NotchWin.ico</ApplicationIcon>
    <Product>NotchWin</Product>
    <AssemblyTitle>NotchWin</AssemblyTitle>
    <Description>A notch for Windows: music, files, system, calendar, weather and notifications.</Description>
    <Version>1.0.0</Version>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\NotchWin.ico" />
    <None Include="installer\**" />
  </ItemGroup>

</Project>
